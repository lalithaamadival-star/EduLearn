# Virtual environments
venv/
backend/venv/
ENV/
env/

# Python cache & compiled files
__pycache__/
backend/app/**/__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Audio and temporary cache
backend/cache/
backend/app/audio_cache/
*.mp3

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Environment variables (Protect secrets)
.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Temporary & scratch files
scratch/
.DS_Store
Thumbs.db
*.swp
