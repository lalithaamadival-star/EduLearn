# ============================================================
# ACCESS-ED BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Supabase PostgreSQL & Auth & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Primary AI Provider (Groq)
PRIMARY_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider (OpenRouter)
FALLBACK_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Document Intelligence / OCR (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Local Cache Directory for Audio & Processed Docs
AUDIO_CACHE_DIR=./cache/audio
STORAGE_LOCAL_DIR=./storage
